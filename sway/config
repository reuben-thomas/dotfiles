### Defaults
#
    set $mod Mod4
    set $left h
    set $down j
    set $up k
    set $right l

    # Terminal Emulator
    set $term foot

    # Fonts
    font pango:JetBrains Mono NF 10px

    # App Launcher
    set $menu wofi

    # Notifications
    exec_always /bin/sh -c "killall mako; mako &"
    include /etc/sway/config-vars.d/*

    # Gnome Keyring
    exec dbus-update-activation-environment --all
 
    # Environment Variables
    exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

### App Setting
#
    # Icons
    for_window [app_id="zathura"] title_format '󰈙 ' %title
    for_window [app_id="okular"] title_format '󰈙 ' %title
    for_window [app_id="google-chrome"] title_format ' ' %title
    for_window [app_id="firefox"] title_format ' ' %title
    for_window [app_id="libreoffice-writer"] title_format ' ' %title
    for_window [app_id="libreoffice-impress"] title_format '󱎐 ' %title
    for_window [app_id="libreoffice-calc"] title_format '󱎏 ' %title
    for_window [class="jetbrains-idea"] title_format ' ' %title
    for_window [class="Slack"] title_format '󰒱 ' %title
    for_window [title=".*Brave$"] title_format ' ' %title
    for_window [title="Spotify Premium"] title_format ' ' %title
    for_window [title="Claude"] title_format '󰅏 ' %title
    for_window [title="^.*Obsidian - Obsidian v1.*$"] title_format '󰎚 ' %title
    for_window [title=".*Visual Studio Code$"] title_format '󰨞 ' %title
    for_window [title="^.*foot.*$"] title_format ' '  %title
    for_window [title="^.*bash.*$"] title_format ' '  %title
    for_window [title="^.*nvim.*$"] title_format ' ' %title
    for_window [title="^.*R Graphics.*$"] title_format ' ' %title

    # Transparency
    set $default_overlay_opacity 0.90

    # Firefox Picture-in-Picture
    for_window [title="Picture-in-picture$"] floating enable, sticky enable, move position cursor, opacity $default_overlay_opacity
    # Chrome Picture-in-Picture
    for_window [title="Picture-in-Picture$"] floating enable, sticky enable, move position cursor, opacity $default_overlay_opacity

    # Okular Notes
    for_window [title="New Text Note — Okular"] floating enable, move position cursor

    # GNUPlot
    for_window [app_id="gnuplot_qt"] floating enable, move position center

    for_window [app_id="it.catboy.ripdrag"] floating enable, move position center

    # Spotify
    for_window [title="Spotify MiniPlayer"] floating enable, sticky enable, resize set 325 360

    # Tidal
    for_window [title="TIDAL.*"] floating disable

    # Zenity / pkexec
    for_window [app_id="zenity"] floating enable, move position center

    # Kooha
    for_window [app_id="io.github.seadve.Kooha"] floating enable, move position center

    # Zathura
    for_window [app_id="zathura"] tabbed enable

    # Yazi Scratchpad
    exec $term \
        --app-id scratchpadTerm \
        -e bash -ic yazi
    for_window [app_id="scratchpadTerm"] \
        floating enable, \
        move position center, \
        move scratchpad

    # Claude Scratchpad
    set $claude_ext fmpnliohjhemenmnlpbfagaolkdacoja
    set $claude_win brave-fmpnliohjhemenmnlpbfagaolkdacoja-Default
    exec brave-browser --app-id=$claude_ext
    for_window [app_id="$claude_win"] \
        floating enable, \
        opacity $default_overlay_opacity, \
        move position center, \
        move scratchpad

### Styling
#
    smart_borders on
    hide_edge_borders smart
    default_border pixel 3
    titlebar_padding 5 1
    titlebar_border_thickness 0
    for_window [class=".*"] border pixel 3

    # Gaps
    set $default_gaps 0
    # Gaps for current workspaces
    exec_always swaymsg gaps inner all set $default_gaps
    # Gaps for future workspaces
    exec_always swaymsg gaps inner $default_gaps

    # Border colouring
    set $cl_gray #8b97ad
    set $cl_high #4b8de3
    set $cl_fade #566a82
    set $cl_back #27303b
    set $cl_fore #484c4f
    set $cl_urge #e35660
    set $cl_text #ffffff

    #                       # border # bg     #txt     indi     #child border
    client.focused          $cl_high $cl_high $cl_text $cl_text $cl_high
    client.focused_inactive $cl_fade $cl_fade $cl_text $cl_gray $cl_fade
    client.unfocused        $cl_fade $cl_back $cl_text $cl_back $cl_back
    client.urgent           $cl_urge $cl_urge $cl_text $cl_urge $cl_urge

### Display Outputs
#
    # Wallpaper
    output * bg $HOME/Pictures/Wallpapers/bergamo_1.JPG fill
    # output * bg "#000000" solid_color

    # Set display configuration if one exists
    exec_always /bin/sh -c "$HOME/.cargo/bin/sway-displays set"

    # Toggle built-in display upon closed/open events
    set $builtin-monitor eDP-1
    workspace 0 output $builtin-monitor
    bindswitch lid:on output $builtin-monitor disable
    bindswitch lid:off output $builtin-monitor enable
    exec_always cat /proc/acpi/button/lid/LID0/state | awk '{print $2}' | grep -q 'closed' && swaymsg output $builtin-monitor disable


### Status Bar:
#
    exec_always /bin/sh -c "$HOME/.config/yambar/scripts/launch-yambar.sh"

### Input configuration
#
    # Built-in trackpad
    input "1267:12572:VEN_04F3:00_04F3:311C_Touchpad" {
        tap enabled
        accel_profile "adaptive"
        pointer_accel 0.7
        natural_scroll enabled
        middle_emulation enabled
    }

    # Logitech MX Anywhere 2S (Bluetooth)
    input "1133:45082:MX_Anywhere_2S_Mouse" {
        pointer_accel 0.1
        accel_profile "adaptive"
    }

    # Keychron M6 8K (Bluetooth)
    input "13364:53321:Keychron_M6_8K_Mouse" {
        accel_profile "adaptive"
    }

    # Keychron M6 8K (USB)
    input "13364:53288:Keychron_Keychron_Ultra-Link_8K" {
        accel_profile "adaptive"
    }

### Key bindings
#
# Volume & Brightness
#
    # Volume
    exec pactl set-sink-volume @DEFAULT_SINK@ 0 150%
    bindsym XF86AudioRaiseVolume exec pactl set-sink-mute @DEFAULT_SINK@ 0 && pactl set-sink-volume @DEFAULT_SINK@ +5%
    bindsym XF86AudioLowerVolume exec pactl set-sink-mute @DEFAULT_SINK@ 0 && pactl set-sink-volume @DEFAULT_SINK@ -5%     
    bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

    # Next and Previous
    bindcode 172 exec playerctl play-pause
    bindcode 171 exec playerctl next
    bindcode 173 exec playerctl previous

    # Built-in Brightness
    bindsym XF86MonBrightnessUp exec brightnessctl set +5%
    bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

    # External Display Brightness
    bindsym $mod+Alt+Down exec ddcutil setvcp 10 - 10 --noverify --async
    bindsym $mod+Alt+Up exec ddcutil setvcp 10 + 10 --noverify --async

    # Toggle Theme
    bindsym $mod+n exec /bin/sh -c "$HOME/.config/scripts/theme-toggle.sh dark"
    bindsym $mod+Shift+n exec /bin/sh -c "$HOME/.config/scripts/theme-toggle.sh light"

    # Toggle DND
    bindsym $mod+Alt+n exec /bin/sh -c "$HOME/.config/scripts/dnd-toggle.sh"

#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term
    bindsym $mod+Shift+Return exec $term tmux new-session -A -s "$(golang-petname -separator '_')"
    bindsym $mod+Alt+Return exec $term yazi

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Open File Manager
    bindsym $mod+y exec nautilus
    bindsym $mod+Shift+y exec $term yazi

    # Start your launcher
    bindsym $mod+d exec $menu --show=drun -a
    bindsym $mod+Shift+d exec $menu
    bindsym $mod+Alt+d exec /bin/sh -c "$HOME/.config/wofi/window_switcher/launch.sh"

    # Drag windows by holding down $mod and left mouse button.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaymsg exit

    # Launch Power Menu
    bindsym $mod+x exec /bin/sh -c "$HOME/.config/wofi/powermenu/launch.sh"

    # Gaps when i feel like it
    bindcode $mod+Shift+35  exec swaymsg gaps inner all minus 10
    bindcode $mod+Shift+34 exec swaymsg gaps inner all plus 10
    bindcode $mod+Shift+51 exec swaymsg gaps inner all set $default_gaps

    # Transparency when I feel like it
    bindcode $mod+Alt+35  exec swaymsg opacity plus 0.05
    bindcode $mod+Alt+34 exec swaymsg opacity minus 0.05
    bindcode $mod+Alt+51 exec swaymsg opacity set 1.0

#
# Moving around:
#
    # Move Position
    bindsym $mod+m move position center
    bindsym $mod+Shift+m move position cursor

    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right    
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused windowlwith the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces
#
    # Rename Workspace
    bindsym $mod+r exec /bin/sh -c "$HOME/.config/wofi/rename_workspace/launch.sh"

    # Persistent home
    set $ws_home 0
    bindcode $mod+9 workspace $ws_home
    bindcode $mod+49 workspace $ws_home
    bindcode $mod+Shift+9 move container to workspace $ws_home, workspace $ws_home
    bindcode $mod+Shift+49 move container to workspace $ws_home, workspace $ws_home
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1, workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2, workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3, workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4, workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5, workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6, workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7, workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8, workspace number 8 
    bindsym $mod+Shift+9 move container to workspace number 9, workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10, workspace number 10
    # Move workspace to output
    bindsym $mod+Control+Shift+$right move workspace to output right
    bindsym $mod+Control+Shift+$left move workspace to output left
    bindsym $mod+Control+Shift+$down move workspace to output down
    bindsym $mod+Control+Shift+$up move workspace to output up
    bindsym $mod+Control+Shift+Right move workspace to output right
    bindsym $mod+Control+Shift+Left move workspace to output left
    bindsym $mod+Control+Shift+Down move workspace to output down
    bindsym $mod+Control+Shift+Up move workspace to output up
    # Workspace Switching
    bindcode $mod+34 workspace prev
    bindcode $mod+35 workspace next
    # Gestures
    bindgesture swipe:right workspace prev
    bindgesture swipe:left workspace next
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv
    bindsym $mod+u splitv
    bindsym $mod+i splith
    bindsym $mod+o split none

    # Switch the current container between different layout styles
    bindsym $mod+t splitv,layout tabbed
    bindsym $mod+w layout toggle split tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+Shift+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Picture-in-picture
    bindsym $mod+Alt+p sticky toggle, floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
    bindsym $mod+s focus child
    bindsym $mod+Alt+a focus parent, focus parent
    bindsym $mod+Alt+s focus child, focus child
#
# Scratchpad:
#
    # Toggle Claude scratchpad
    bindsym $mod+Shift+semicolon [app_id="$claude_win"] scratchpad show; \
        [app_id="scratchpadTerm" workspace=__focused__] move scratchpad
    bindsym $mod+f [app_id="$claude_win"] scratchpad show, move position center; \
        [app_id="scratchpadTerm" workspace=__focused__] move scratchpad

    # Toggle Yazi scratchpad
    bindsym $mod+semicolon [app_id="scratchpadTerm"] scratchpad show, move position center; \
        [app_id="$claude_win" workspace=__focused__] move scratchpad

    # Restore default scratchpad
    bindsym $mod+Alt+semicolon [app_id="scratchpadTerm"] kill; \
        [app_id="$claude_win"] kill; \
        exec $term --app-id scratchpadTerm -e bash -ic yazi; \
        exec brave-browser --app-id=$claude_ext
#
# Mirroring
#
    bindsym $mod+p exec /bin/sh -c "$HOME/.config/wofi/wl-mirror/launch.sh"
#
# Capture
#
    set $capture ~/.config/scripts/capture.sh
    mode "capture-shot" {
        bindsym a mode "default"; exec $capture shot all
        bindsym w mode "default"; exec $capture shot window
        bindsym o mode "default"; exec $capture shot output
    }
    mode "capture-gif" {
        bindsym a mode "default"; exec $capture gif all
        bindsym w mode "default"; exec $capture gif window
        bindsym o mode "default"; exec $capture gif output
    }
    mode "capture-video" {
        bindsym a mode "default"; exec $capture video all
        bindsym w mode "default"; exec $capture video window
        bindsym o mode "default"; exec $capture video output
    }
    bindsym $mod+Shift+s exec $capture pick shot
    bindsym $mod+Shift+r exec $capture pick gif
    bindsym $mod+Shift+v exec $capture pick video
    bindsym $mod+c exec ~/.local/bin/uv run --script ~/.config/scripts/screenshot.py
#
# Resizing
#
    bindsym $mod+Alt+t resize set height 20 ppt
    bindsym $mod+Alt+$left resize shrink width 5
    bindsym $mod+Alt+$up resize grow height 5
    bindsym $mod+Alt+$down resize shrink height 5
    bindsym $mod+Alt+$right resize grow width 5
    bindsym $mod+Alt+u resize set height 50
    bindsym $mod+Alt+i resize set width 50

include /etc/sway/config.d/*
